# ============================================================
# Environment Variables — Capstone Part 3
# ============================================================
# Copy this file to .env and fill in the actual values:
#   cp .env.example .env
#
# NEVER commit the .env file to version control.
# ============================================================

# Flask application secret key (used for session signing)
SECRET_KEY=placeholder_secret_key

# Admin API key for the /admin endpoint authentication
ADMIN_API_KEY=placeholder_admin_key

# Database path
DATABASE_PATH=app.db

# Flask debug mode (set to "true" for development, "false" for production)
FLASK_DEBUG=false
