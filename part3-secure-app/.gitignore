# ============================================================
# .gitignore — Capstone Part 3
# ============================================================

# Environment variables — NEVER commit real secrets
.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Virtual environment
venv/
env/
.venv/

# Database
*.db
*.sqlite3

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Security reports (generated by CI/CD)
bandit-report.json
semgrep-report.json
